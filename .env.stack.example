# ---------------------------------------------------------------------------
# Secrets for the ALL-IN-ONE stack (docker-compose.stack.yml).
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Monitor ---
APP_ENV=production
ROOT_PATH=
AUTH_ENABLED=true
LAN_ONLY=false
ADMIN_USERNAME=admin
# Generate: cd backend && python -m app.cli hash-password 'your-password'
ADMIN_PASSWORD_HASH=
# Generate: cd backend && python -m app.cli gen-secret
SESSION_SECRET=
COOKIE_SECURE=false
OPENROUTER_MANAGEMENT_KEY=

# --- Evolution API (shared) ---
# Strong random value — used as the Evolution admin/API key AND by the monitor.
EVOLUTION_API_KEY=
# The monitor reaches Evolution over the internal network by default:
EVOLUTION_API_URL=http://evolution-api:8080
# Instance name you will create in Evolution (and pair via QR):
EVOLUTION_INSTANCE=openrouter-monitor
# Destination WhatsApp number (country code + number, digits only):
WHATSAPP_DESTINATION=55XXXXXXXXXXX

# --- Evolution Postgres ---
POSTGRES_PASSWORD=
