# ---------------------------------------------------------------------------
# BACKEND configuration (secrets + core). Copy to backend/.env and fill in.
# Never commit the real backend/.env. No secret is ever shown in the UI or DB.
# ---------------------------------------------------------------------------

# Application
# APP_ENV=production enforces secure config at startup: AUTH_ENABLED=true, a
# strong SESSION_SECRET (>=32 chars), and a valid ADMIN_PASSWORD_HASH are
# REQUIRED or the app refuses to start. Use APP_ENV=development for local dev.
APP_ENV=production
APP_HOST=0.0.0.0
# Internal port (Coolify-configurable). Default 8080.
APP_PORT=8080

# OpenRouter (REQUIRED). Management/credits key — read-only credit balance.
OPENROUTER_MANAGEMENT_KEY=
# Override only for testing; defaults to https://openrouter.ai
# OPENROUTER_BASE_URL=https://openrouter.ai

# Evolution API (send channel for WhatsApp)
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=openrouter-monitor
WHATSAPP_DESTINATION=55XXXXXXXXXXX

# Admin auth. Generate the hash with:
#   python -m app.cli hash-password 'your-password'
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Random string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Set true only when served over HTTPS end-to-end (adds Secure flag to cookies).
COOKIE_SECURE=false

# Database — absolute path inside the container (persisted via /app/data volume).
DATABASE_URL=sqlite:////app/data/monitor.db

# NOTE: the alert threshold is NOT configured here. It lives in SQLite and is
# edited from the Web UI (default 10.00 USD on first start).
