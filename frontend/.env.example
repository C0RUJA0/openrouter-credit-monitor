# ---------------------------------------------------------------------------
# FRONTEND configuration (presentation + reverse-proxy path). Copy to
# frontend/.env. The UI is server-rendered (Jinja2) by the backend process;
# these vars control how it is presented and mounted. No secrets here.
# ---------------------------------------------------------------------------

# Page/app title shown in the UI.
APP_TITLE=OpenRouter Credit Monitor

# Path prefix the Central serves this app under (reverse proxy). MUST match the
# Central route. Empty string means mounted at "/". Do NOT create a subdomain.
ROOT_PATH=/apps/openrouter-monitor

# Location of templates/static. Leave unset to use the repo's ./frontend dir.
# FRONTEND_DIR=/app/frontend
